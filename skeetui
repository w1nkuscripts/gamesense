				gearBtn.Position = UDim2.new(1, rightOffset - 12, 0, 3)
				gearBtn.BackgroundTransparency = 1
				gearBtn.Image = "rbxassetid://3926307971"
				gearBtn.ImageRectOffset = Vector2.new(324, 124)
				gearBtn.ImageRectSize = Vector2.new(36, 36)
				gearBtn.ImageColor3 = Theme.TextDark
				gearBtn.Parent = container

				gearBtn.MouseButton1Click:Connect(function()
					currentFeatureForBind = text
					isBinding = false
					activeGearButton = nil
					justOpenedGear = true
					lastGearBtn = gearBtn
					
					local bindData = BoundKeys[text]
					local boundKey = bindData and bindData.key
					local boundMode = bindData and bindData.mode or "toggle"
					
					if boundKey then
						local displayKey = string.lower(boundKey)
						displayKey = displayKey:gsub("mousebutton", "mb")
						BindButton.Text = "[" .. displayKey .. "]"
					else
						BindButton.Text = "[ - ]"
					end
					BindButton.TextColor3 = Theme.TextMain
					
					for _, child in ipairs(ModeContainer:GetChildren()) do
						if child:IsA("TextButton") then
							child.TextColor3 = (child.Text == boundMode) and Theme.TextMain or Theme.TextDark
						end
					end
					
