	local function UpdateFeatureState(data)
		if data.mode == "always" then
			data.state = true
		elseif data.mode == "hold" then
			data.state = data.holding or false
		elseif data.mode == "toggle" then
			data.state = data.userState or false
		end
		if data.updateVisual then 
			data.updateVisual(data.state) 
		end
		if data.callback then
			data.callback(data.state)
		end
	end

	local function CreateModeBtn(name)
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(0.31, 0, 1, 0)
		btn.BackgroundColor3 = Theme.ElementBg
		btn.Text = name
		btn.TextColor3 = Theme.TextDark
		btn.Font = FontStyle
		btn.TextSize = 9
		btn.ZIndex = 41
		btn.Parent = ModeContainer
		CreateCorner(btn, 3)
		CreateStroke(btn, Theme.Border, 1)
		
		btn.MouseButton1Click:Connect(function()
			for _, child in ipairs(ModeContainer:GetChildren()) do
				if child:IsA("TextButton") then
					child.TextColor3 = Theme.TextDark
				end
			end
			btn.TextColor3 = Theme.TextMain
			if BoundKeys[currentFeatureForBind] then
				BoundKeys[currentFeatureForBind].mode = name
				UpdateFeatureState(BoundKeys[currentFeatureForBind])
			end
		end)
		return btn
	end

	local mToggle = CreateModeBtn("toggle")
	local mHold = CreateModeBtn("hold")
