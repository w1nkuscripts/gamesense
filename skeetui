	local currentHue, currentSat, currentVal = 0, 1, 1
	local activeColorCallback = nil

	local function UpdateColor()
		SatValMap.BackgroundColor3 = Color3.fromHSV(currentHue, 1, 1)
		local finalCol = Color3.fromHSV(currentHue, currentSat, currentVal)
		if activeColorCallback then activeColorCallback(finalCol) end
	end

	local isDraggingSatVal, isDraggingHue = false, false

	SatValBtn.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then isDraggingSatVal = true end end)
	HueSlider.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then isDraggingHue = true end end)
	UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then isDraggingSatVal = false; isDraggingHue = false end end)
	UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			if isDraggingSatVal then
				local x = math.clamp((input.Position.X - SatValMap.AbsolutePosition.X) / SatValMap.AbsoluteSize.X, 0, 1)
				local y = math.clamp((input.Position.Y - SatValMap.AbsolutePosition.Y) / SatValMap.AbsoluteSize.Y, 0, 1)
				currentSat = x; currentVal = 1 - y
				SatValCursor.Position = UDim2.new(x, -2, y, -2)
				UpdateColor()
			elseif isDraggingHue then
				local y = math.clamp((input.Position.Y - HueSlider.AbsolutePosition.Y) / HueSlider.AbsoluteSize.Y, 0, 1)
				currentHue = 1 - y
				UpdateColor()
			end
		end
	end)

