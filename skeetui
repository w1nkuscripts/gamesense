			function Section:AddToggle(text, default, callback, color)
				local container = Instance.new("Frame")
				container.Size = UDim2.new(1, 0, 0, 18)
				container.BackgroundTransparency = 1
				container.Parent = section

				local box = Instance.new("TextButton")
				box.Size = UDim2.new(0, 12, 0, 12)
				box.Position = UDim2.new(0, 0, 0, 3)
				box.BackgroundColor3 = Theme.ElementBg
				box.Text = ""
				box.Parent = container
				CreateCorner(box, 2)
				CreateStroke(box, Theme.Border, 1)

				local fill = Instance.new("Frame")
				fill.Size = UDim2.new(1, -4, 1, -4)
				fill.Position = UDim2.new(0, 2, 0, 2)
				fill.BackgroundColor3 = Theme.TextDark
				fill.Visible = default or false
				fill.BorderSizePixel = 0
				fill.Parent = box
				CreateCorner(fill, 1)

				local label = Instance.new("TextLabel")
				label.Size = UDim2.new(0, 110, 1, 0)
				label.Position = UDim2.new(0, 18, 0, 0)
				label.BackgroundTransparency = 1
				label.Text = text
				label.TextColor3 = default and Theme.TextMain or Theme.TextDark
				label.Font = FontStyle
				label.TextSize = 12
				label.TextXAlignment = Enum.TextXAlignment.Left
				label.Parent = container

				local isChecked = default or false

				local function SetState(newState)
					isChecked = newState
					fill.Visible = isChecked
					label.TextColor3 = isChecked and Theme.TextMain or Theme.TextDark
					if callback then callback(isChecked) end
				end

				box.MouseButton1Click:Connect(function()
					isChecked = not isChecked
					SetState(isChecked)
					if BoundKeys[text] then BoundKeys[text].userState = isChecked end
				end)

				if not BoundKeys[text] then
					BoundKeys[text] = {key = nil, mode = "toggle", state = isChecked, userState = isChecked, holding = false, updateVisual = SetState, callback = callback}
				else
					BoundKeys[text].updateVisual = SetState
					BoundKeys[text].userState = isChecked
				end

				local rightOffset = -2

				if color then
					local colorBox = Instance.new("TextButton")
					colorBox.Size = UDim2.new(0, 14, 0, 10)
					colorBox.Position = UDim2.new(1, rightOffset - 14, 0, 4)
					colorBox.BackgroundColor3 = color
					colorBox.Text = ""
