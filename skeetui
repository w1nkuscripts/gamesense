	BindButton.MouseButton1Click:Connect(function()
		isBinding = true
		activeGearButton = BindButton
		BindButton.TextColor3 = Theme.Accent
	end)

	local function AssignKey(keyName)
		isBinding = false
		activeGearButton = nil
		if keyName == "Escape" then
			if BoundKeys[currentFeatureForBind] then
				BoundKeys[currentFeatureForBind].key = nil
			end
			BindButton.Text = "[ - ]"
		else
			local displayKey = string.lower(keyName)
			displayKey = displayKey:gsub("mousebutton", "mb")
			if not BoundKeys[currentFeatureForBind] then
				BoundKeys[currentFeatureForBind] = {key = keyName, mode = "toggle", state = false, userState = false, holding = false}
			else
				BoundKeys[currentFeatureForBind].key = keyName
			end
			BindButton.Text = "[" .. displayKey .. "]"
		end
		BindButton.TextColor3 = Theme.TextMain
		task.wait(0.2)
		GearPopup.Visible = false
	end

	UserInputService.InputBegan:Connect(function(input)
		if isBinding then
			if input.UserInputType == Enum.UserInputType.Keyboard then
				AssignKey(input.KeyCode.Name)
			elseif input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.MouseButton2
				or input.UserInputType == Enum.UserInputType.MouseButton3 then
				AssignKey(input.UserInputType.Name)
			end
		else
			for _, data in pairs(BoundKeys) do
				if data.key then
					local triggered = false
					if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode.Name == data.key then
						triggered = true
					elseif input.UserInputType.Name == data.key then
						triggered = true
					end

					if triggered then
						if data.mode == "toggle" then
							data.userState = not data.userState
							UpdateFeatureState(data)
						elseif data.mode == "hold" then
							data.holding = true
							UpdateFeatureState(data)
						end
					end
				end
			end
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		for _, data in pairs(BoundKeys) do
			if data.key and data.mode == "hold" then
				local released = false
				if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode.Name == data.key then
					released = true
				elseif input.UserInputType.Name == data.key then
					released = true
				end
				if released then
					data.holding = false
					UpdateFeatureState(data)
				end
			end
		end
	end)

	UserInputService.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			if justOpenedGear then
				justOpenedGear = false
				return
			end
			local mPos = UserInputService:GetMouseLocation()
			if GearPopup.Visible then
				local clickedGear = false
				if lastGearBtn then
					local gPos, gSize = lastGearBtn.AbsolutePosition, lastGearBtn.AbsoluteSize
					if mPos.X >= gPos.X and mPos.X <= gPos.X + gSize.X and mPos.Y >= gPos.Y and mPos.Y <= gPos.Y + gSize.Y then
						clickedGear = true
					end
				end
				if not clickedGear then
					local gPos, gSize = GearPopup.AbsolutePosition, GearPopup.AbsoluteSize
					if mPos.X < gPos.X or mPos.X > gPos.X + gSize.X or mPos.Y < gPos.Y or mPos.Y > gPos.Y + gSize.Y then
						GearPopup.Visible = false
						isBinding = false
						activeGearButton = nil
						BindButton.TextColor3 = Theme.TextMain
					end
				end
			end
		end
	end)

